    },
    {
      "id": "libreoffice",
      "role": "DOCX PDF render",
      "verify": "soffice --version",
      "command_example": "soffice --headless --convert-to pdf --outdir out input.docx",
      "source": "https://www.libreoffice.org/download/"
    },
    {
      "id": "pymupdf",
      "role": "PDF text/page check",
      "verify": "python -c \"import fitz;print(fitz.__doc__[:15])\"",
